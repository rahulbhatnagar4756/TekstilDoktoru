<Window x:Class="TekstilDoktoru.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TekstilDoktoru.Views"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Tekstil Doktoru" Height="600" Width="900">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Background="LightGray">
            <Button Content="Import DXF" Margin="5"/>
            <ComboBox Width="100" Margin="5">
                <ComboBoxItem>100%</ComboBoxItem>
                <ComboBoxItem>75%</ComboBoxItem>
                <ComboBoxItem>50%</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Width="60" DockPanel.Dock="Left" Background="LightGray">
            <Button Content="Select" Height="40" Margin="5"/>
            <Button Content="Line" Height="40" Click="LineTool_Click" Margin="5"/>
            <Button Content="Curve" Height="40" Margin="5"/>
        </StackPanel>
        <Grid>
            <skia:SKElement Name="SkiaCanvas" PaintSurface="OnPaintSurface"/>
        </Grid>
    </DockPanel>
</Window>